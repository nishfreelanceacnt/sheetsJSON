# ── Required for paid plans ──────────────────────────────────────────────────
# Get these from your Stripe dashboard (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_PRO=price_...          # Monthly Pro price ID
STRIPE_PRICE_PLUS=price_...         # Monthly Plus price ID
STRIPE_WEBHOOK_SECRET=whsec_...     # From Stripe → Webhooks → your endpoint

# Your deployed URL (no trailing slash). Used in Stripe redirect URLs & emails.
PUBLIC_BASE_URL=https://yourdomain.com

# ── Database ─────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (usage.db) — fine for small deploys.
# Set to a postgres:// URL for production (Render / Railway / Neon free tier).
DATABASE_URL=

# ── Admin panel (/admin/keys) ────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=change-me-before-deploy

# ── API key behaviour ────────────────────────────────────────────────────────
REQUIRE_API_KEY=true        # Set false to allow keyless access (not recommended)
KEY_AUTO_ISSUE=true         # Automatically issue keys on /request-key form
KEYS_BACKEND=db             # 'db' (default) or 'file' (uses keys.json)
RATE_LIMIT_PER_MIN=90

# ── Caching ──────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300       # How long to cache each Google Sheet in memory

# ── Email (optional — for key delivery + notifications) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
KEY_REQUEST_TO=you@gmail.com    # Who receives key request notifications
KEY_REQUEST_MODE=file           # 'file' logs to key_requests.jsonl, 'email' sends SMTP

# ── Analytics / SEO (optional) ───────────────────────────────────────────────
PLAUSIBLE_DOMAIN=yourdomain.com       # Leave blank to disable Plausible
GOOGLE_SITE_VERIFICATION=             # Google Search Console meta tag value

# ── Stripe behaviour ─────────────────────────────────────────────────────────
STRIPE_AUTOMATIC_TAX=0          # Set 1 to enable Stripe Tax
CANCEL_DOWNGRADE_PLAN=free      # Plan to downgrade to on cancellation/failed payment

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=*            # Restrict to your domain in production: https://yourdomain.com

# ── Error tracking (optional) ────────────────────────────────────────────────
SENTRY_DSN=
